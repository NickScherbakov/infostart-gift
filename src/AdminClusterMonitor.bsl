// AdminClusterMonitor — модуль логики мониторинга процессов кластера 1С

&НаСервере
Функция ПолучитьСписокПроцессовКластера(Профиль) Экспорт
    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("IdПроцесса");
    Результат.Колонки.Добавить("ВремяЗапуска", Новый ОписаниеТипов("Дата"));
    Результат.Колонки.Добавить("ВозрастМинут", Новый ОписаниеТипов("Число"));
    Результат.Колонки.Добавить("КолСоединений", Новый ОписаниеТипов("Число"));
    Результат.Колонки.Добавить("Пользователь");
    Результат.Колонки.Добавить("База");
    Результат.Колонки.Добавить("Хост");

    Попытка
        // В реальной среде вызов API ras/ragent или внешней COM/CLI-утилиты
        Процессы = УправлениеКластером.ПолучитьСписокПроцессов(Профиль.RasHost, Профиль.RasPort);
        Для Каждого П Из Процессы Цикл
            Стр = Результат.Добавить();
            Стр.IdПроцесса = П.Идентификатор;
            Стр.ВремяЗапуска = П.ВремяЗапуска;
            Стр.ВозрастМинут = Окр(РазностьДат(ТекущаяДата(), П.ВремяЗапуска) * 24 * 60, 0);
            Стр.КолСоединений = П.КоличествоСоединений;
            Стр.Пользователь = П.Пользователь;
            Стр.База = П.ИмяБазы;
            Стр.Хост = П.Хост;
        КонецЦикла;
    Исключение
        Сообщить("Ошибка при получении списка процессов: " + ОписаниеОшибки());
    КонецПопытки;

    Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВыполнитьПроверкуИУведомить(Профиль)
    Таб = ПолучитьСписокПроцессовКластера(Профиль);
    Период = Настройки.ПериодПерезапускаМинут;

    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("IdПроцесса");
    Результат.Колонки.Добавить("ВозрастМинут");
    Результат.Колонки.Добавить("КолСоединений");
    Результат.Колонки.Добавить("ФлагСтаричок");

    Для Каждого Стр Из Таб Цикл
        НовСтр = Результат.Добавить();
        НовСтр.IdПроцесса = Стр.IdПроцесса;
        НовСтр.ВозрастМинут = Стр.ВозрастМинут;
        НовСтр.КолСоединений = Стр.КолСоединений;
        НовСтр.ФлагСтаричок = (Стр.ВозрастМинут > Период) И (Стр.КолСоединений = 0);
    КонецЦикла;

    // Экспорт отчета и вызов внешнего скрипта уведомлений
    ПутьЭкспорта = Настройки.ПутьКHelper + "/export_report.csv";

    Если Результат.Строки.Найти(Новый УсловиеПоКолонке("ФлагСтаричок", Истина)) <> Неопределено Тогда
        Команда = "/bin/sh " + Настройки.ПутьКHelper + "/admincluster_notify.sh --profile " + Профиль.Имя + " --file " + ПутьЭкспорта;
        Если Настройки.DryRun Тогда
            ВыполнитьКоманду(Команда + " --dry-run", Истина);
        Иначе
            ВыполнитьКоманду(Команда, Истина);
        КонецЕсли;
    КонецЕсли;

    Сообщить("Проверка завершена для профиля: " + Профиль.Имя);
КонецПроцедуры
